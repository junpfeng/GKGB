        <mxCell id="Sspnw460WEY0gJR3UPId-94" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;table style=&quot;border-collapse: collapse; width: 784px;&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;流派&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;代表人物&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;核心观点&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;学习实质&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;典型理论 / 实验&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;教育启示&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;行为主义&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;华生、斯金纳、班杜拉、桑代克&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;❌排斥内部心理&lt;div&gt;&lt;/div&gt;✅&lt;strong class=&quot;container-nB6Z1e&quot;&gt;学习 = 刺激与反应 (S-R) 建立联结&lt;/strong&gt;，看重外部环境、可观测行为；强化塑造行为&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;形成刺激 - 反应联结&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;桑代克试误说&lt;div&gt;&lt;/div&gt;斯金纳操作性条件反射&lt;div&gt;&lt;/div&gt;班杜拉观察学习（自我效能感）&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;多用奖励、强化；及时反馈；树立榜样；控制外部环境塑造行为&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;认知主义&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;苛勒、布鲁纳、奥苏贝尔、加涅&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;重视大脑内部认知过程，&lt;strong class=&quot;container-nB6Z1e&quot;&gt;学习不是被动刺激反应，是主动加工信息&lt;/strong&gt;；关注知觉、记忆、思维、理解&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;主动构建认知结构、信息加工&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;苛勒顿悟说&lt;div&gt;&lt;/div&gt;布鲁纳发现学习&lt;div&gt;&lt;/div&gt;奥苏贝尔有意义接受学习&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;重视知识逻辑结构；提倡理解学习，反对机械死记硬背&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;建构主义&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;皮亚杰、维果茨基&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;知识不是客观真理，&lt;strong class=&quot;container-nB6Z1e&quot;&gt;学习者基于原有经验主动建构知识&lt;/strong&gt;；情境性、社会互动重要；没有绝对标准答案&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;在原有经验基础上主动建构意义&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;皮亚杰认知发展理论&lt;div&gt;&lt;/div&gt;维果茨基最近发展区&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;以学生为主体；创设问题情境；小组合作探究；重视学生已有经验&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;人本主义&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;马斯洛、罗杰斯&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;以完整的 “人” 为中心；&lt;strong class=&quot;container-nB6Z1e&quot;&gt;重视情感、需要、自尊、自我实现&lt;/strong&gt;；强调无条件积极关注&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;人的潜能自我实现，追求完整人格&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;马斯洛需求层次&lt;div&gt;&lt;/div&gt;罗杰斯非指导性教学&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;营造安全包容课堂；尊重学生；关注情绪与内在动机；学生自主选择学习内容&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="396" width="820" x="140" y="1447" as="geometry" />
        </mxCell>
