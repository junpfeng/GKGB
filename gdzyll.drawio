        <mxCell id="Sspnw460WEY0gJR3UPId-247" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;table style=&quot;border-collapse: collapse; width: 784px;&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;划分标准&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;类型&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;核心含义&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;例子&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;1. 迁移效果（性质）&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;正迁移&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;促进、有利影响&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;会 C 语言助力学习 C++&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;负迁移&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;干扰、阻碍作用&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;拼音干扰英语音标学习&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;2. 迁移先后方向&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;顺向迁移&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;先前学习影响后续学习&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;先学平面几何，再学立体几何&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;逆向迁移&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;后续学习影响先前学习&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;高等数学加深对中学函数理解&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;3. 抽象水平&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;水平迁移（横向）&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;同一层次知识技能迁移&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;锐角三角形规律迁移到钝角三角形&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;垂直迁移（纵向）&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;上下从属关系&lt;div&gt;&lt;/div&gt;自上而下 / 自下而上&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;掌握 “函数” 概念，学习一次函数&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;4. 迁移内容&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;一般迁移（普遍迁移）&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;原理、思维方法、态度迁移&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;掌握逻辑推理方法用于多门课程&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;具体迁移（特殊迁移）&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;具体经验、动作直接迁移&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;篮球运球迁移到篮球实战&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="317" width="800" x="-1214" y="2883" as="geometry" />
        </mxCell>
        <mxCell id="Sspnw460WEY0gJR3UPId-248" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;table style=&quot;border-collapse: collapse; width: 784px;&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;理论&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;人物&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;核心观点&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;经典实验&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;形式训练说&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;沃尔夫&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;迁移源于心理官能训练，最早迁移理论&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;无实验，偏思辨&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;共同要素说&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;桑代克、伍德沃斯&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;两种学习存在共同成分才会发生迁移&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;形状知觉实验&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;概括说（类化说）&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;贾德&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;迁移关键是学习者概括出共同原理&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;水下击靶实验&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;关系转换说&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;苛勒&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;迁移在于顿悟情境之间的关系&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;小鸡觅食实验&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;认知结构迁移理论&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;奥苏贝尔&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;一切有意义学习都存在迁移；原有认知结构决定迁移效果&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;现代主流理论&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="230" width="800" x="-1214" y="3210" as="geometry" />
        </mxCell>
        <mxCell id="Sspnw460WEY0gJR3UPId-249" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="学习迁移的教学策略：&lt;div&gt;精选教材内容：突出基本概念和原理（数据集要选的好）&lt;/div&gt;&lt;div&gt;合理编排教学内容：知识结构化、体系化（模型要选的好）&lt;/div&gt;&lt;div&gt;合理安排教学程序：先易后难、先旧后新（先训练简单的）&lt;/div&gt;&lt;div&gt;重视基础知识和技能：夯实基础&lt;/div&gt;&lt;div&gt;教授学习策略，提升迁移意识：教会学生学会学习&lt;/div&gt;&lt;div&gt;加强变式练习（类似于数据增强）&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="320" x="-630" y="2745" as="geometry" />
        </mxCell>
