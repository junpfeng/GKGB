        <mxCell id="Sspnw460WEY0gJR3UPId-258" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;table style=&quot;border-collapse: collapse; width: 784px;&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;制度名称&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;核心内容（标准答案）&lt;/th&gt;&lt;th style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;作用定位&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;五早预警制度&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;早发现、早报告、早研判、早预防、早控制&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;心理危机&lt;strong class=&quot;container-nB6Z1e&quot;&gt;前端预警机制&lt;/strong&gt;，把危机化解在萌芽状态&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;心理守门人制度&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;以辅导员、班主任、班委、宿舍长、任课教师为基层守门人，负责日常观察、识别异常、及时上报、初步关怀、协助转介&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;心理危机&lt;strong class=&quot;container-nB6Z1e&quot;&gt;基层排查网络&lt;/strong&gt;，打通预警最后一公里&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;三级预警体系&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;校 — 院 — 班（宿舍）分层分级预警管理&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;系统化层级防控&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;一生一档制度&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;学生心理动态建档、动态跟踪、持续记录&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;精细化长效管理&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;常态化筛查干预&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;定期心理测评、分级疏导、动态干预&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;常态化闭环防控&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;&lt;strong class=&quot;container-nB6Z1e&quot;&gt;家校医社四方协同&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;学校、家庭、医院、社会联动干预处置&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(204, 204, 204); padding: 8px; text-align: left;&quot;&gt;全方位合力育人&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
