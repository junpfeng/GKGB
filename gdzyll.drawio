        <mxCell id="Sspnw460WEY0gJR3UPId-240" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;direction:ltr&quot;&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; valign=&quot;top&quot; style=&quot;direction: ltr; border-style: solid; border-color: rgb(163, 163, 163);&quot; title=&quot;&quot; summary=&quot;&quot;&gt; &lt;tbody&gt;&lt;tr&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 0.85in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;维度&lt;/span&gt;&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 3.4506in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;核心关键词&lt;/span&gt;&lt;/p&gt;&lt;br&gt;  &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 0.85in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;整体定位&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 3.4506in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;心理半成熟，成人过渡关键期&lt;/p&gt;&lt;br&gt;  &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 0.85in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;认知发展&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 3.4506in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;辩证逻辑占主导，思维独立有批判，易片面&lt;/p&gt;&lt;br&gt;  &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 0.85in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;自我意识&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 3.4506in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;追求独立尊重，自我同一性探索，理想现实冲突&lt;/p&gt;&lt;br&gt;  &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 0.85in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;情绪情感&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 3.4506in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;丰富不稳定，社交需求强，婚恋性心理凸显&lt;/p&gt;&lt;br&gt;  &lt;/td&gt; &lt;/tr&gt; &lt;tr&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 0.8694in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri&quot;&gt;00 &lt;/span&gt;&lt;span style=&quot;font-family:&amp;quot;Microsoft YaHei&amp;quot;&quot;&gt;后群体&lt;/span&gt;&lt;/p&gt;&lt;br&gt;  &lt;/td&gt;  &lt;td style=&quot;border-style: solid; border-color: rgb(163, 163, 163); border-width: 1pt; width: 3.5006in; padding: 4pt;&quot;&gt;&lt;br&gt;  &lt;p style=&quot;margin:0in;font-family:&amp;quot;Microsoft YaHei&amp;quot;;font-size:11.0pt&quot;&gt;数字原住民，价值多元，网络依赖，抗挫力待提升&lt;/p&gt;&lt;br&gt;  &lt;/td&gt; &lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="420" width="530" x="-940" y="890" as="geometry" />
        </mxCell>
        <mxCell id="Sspnw460WEY0gJR3UPId-241" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="操作技能（电脑打字）：&lt;div&gt;定向：了解怎么做&lt;/div&gt;&lt;div&gt;模仿：跟着示范尝试操作&lt;/div&gt;&lt;div&gt;整合：将分解动作连接整合&lt;/div&gt;&lt;div&gt;熟练：操作熟练，无多余动作&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="170" x="-1680" y="2760" as="geometry" />
        </mxCell>
        <mxCell id="Sspnw460WEY0gJR3UPId-242" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="心智技能（逻辑推理）：&lt;div&gt;定向：了解心智活动流程（了解推理逻辑）&lt;/div&gt;&lt;div&gt;操作：借助外物，完整流程演练&lt;/div&gt;&lt;div&gt;（使用草稿纸演算全过程）&lt;br&gt;&lt;div&gt;内化：内化进入大脑，自动化加工&lt;/div&gt;&lt;/div&gt;&lt;div&gt;（脑子里自动演算，直接得出结论）&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="230" x="-1480" y="2760" as="geometry" />
        </mxCell>
